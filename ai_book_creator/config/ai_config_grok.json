{
  "provider": "grok",
  "use_openai_client": true,
  "writing_model": "grok-4",
  "review_model": "grok-4-fast",
  "base_url": "https://api.x.ai/v1",
  "api_key_env": "XAI_API_KEY",
  "usage_state_path": "book_output/ai_usage_state.json",
  "timeout": 900,
  "min_book_pages": 250,
  "min_chapter_words": 1200,
  "writing_completion_tokens": 32768,
  "review_completion_tokens": 16384,
  "planning_completion_tokens": 8192,
  "default_completion_tokens": 16384,
  "humanize_rounds": 2,
  "humanize_threshold": 15.0,
  "judge_models": ["grok-4-fast", "grok-4"],
  "models": {
    "grok-4":       { "name": "Grok 4",       "max_output": 32768 },
    "grok-4-fast":  { "name": "Grok 4 Fast",  "max_output": 32768 },
    "grok-3":       { "name": "Grok 3",       "max_output": 32768 },
    "grok-3-mini":  { "name": "Grok 3 Mini",  "max_output": 32768 }
  }
}
