OPENAI_API_KEY=
MINIMAX_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
POLLINATIONS_API_KEY=
# Optional: opencode zen/go keys (fall back to `opencode auth.json` when empty)
OPENCODE_GO_API_KEY=
OPENCODE_ZEN_API_KEY=
# hyper.charm.land (OpenAI-compatible). The `claude` provider needs no key:
# it shells out to the Claude Code CLI on your own subscription.
HYPER_API_KEY=

# Optional overrides
AI_CONFIG_PATH=
AI_BASE_URL=
AI_WRITING_MODEL=
AI_REVIEW_MODEL=
AI_USAGE_STATE_PATH=
AI_GROQ_RATE_STATE_PATH=
AI_BOOK_AUTHOR=
AI_BOOK_MODE=review
# Humanness pass: 0 turns it off. Needs benchmarks/build_prose_baseline.py first.
AI_BOOK_HUMANIZE=1
AI_BOOK_PAGE_RANGE=180-280
AI_BOOK_CHAPTER_RANGE=
AI_BOOK_COVER_SOURCE=pollinations
AI_BOOK_PERCHANCE_STYLE=Cinematic
AI_BOOK_PERCHANCE_TIMEOUT=600
AI_BOOK_BROWSER_LOGIN_TIMEOUT=300
AI_BOOK_BROWSER_PROFILE=
AI_BOOK_PRICE_USD=0.99
AI_BOOK_KDP_PROFILE=
AI_BOOK_KDP_TIMEOUT=900
AI_BOOK_KDP_CATEGORY_IDS=
